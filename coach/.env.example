# Copy to .env and fill in before `docker compose up`.

# Required for LLM-based scoring (scoring/llm.py). Without it, prompt_scores
# never gets an 'llm' row -- heuristic scoring and leveling work regardless.
ANTHROPIC_API_KEY=

# Optional. When set, write endpoints (POST /prompts, POST /sessions/end)
# require a matching X-Coach-Token header. Empty means no auth -- fine for a
# trusted-network pilot, not for anything publicly reachable.
COACH_API_TOKEN=

# Override only if you're not using the bundled docker-compose Postgres.
# DATABASE_URL=postgresql://coach:coach_dev_only@localhost:5433/coach
